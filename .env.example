# Copy this to .env.local for local development.
# In Vercel: add these under Project Settings → Environment Variables.

# Your Groq API key — get one free at https://console.groq.com/keys
# This key lives ONLY on the server. Students never see it.
GROQ_API_KEY=gsk_your_key_here

# Optional: a short password students must enter to access the app.
# Protects your Groq quota from anyone who stumbles across the URL.
# Leave blank (delete this line) to make the app open to anyone with the link.
CLASSROOM_PASSWORD=your_classroom_password_here

# Optional: override the default model (openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
